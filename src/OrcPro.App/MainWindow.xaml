<Window x:Class="OrcPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/favicon.ico"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1366" Height="768"
        MinWidth="1024" MinHeight="768"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="12"
        Background="{StaticResource CanvasBrush}">

    <!-- Legenda nativa (CaptionHeight=32): arrasto, duplo clique (maximizar/restaurar),
         snap de janelas e redimensionamento ficam por conta do Windows.
         Os botões de controle na barra superior usam IsHitTestVisibleInChrome para
         receberem o clique dentro da faixa de legenda. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- O DataContext é definido em code-behind (MainWindow(UsuarioSessaoDto)),
         pois a sessão vem do login. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ============ Barra superior / Title bar ============ -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="3" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="O" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource WhiteBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding AppTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <Border Width="1" Height="13" Background="{StaticResource NavyDividerBrush}"
                            Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CompanyLine}" FontSize="11"
                               Foreground="{StaticResource NavyMutedTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DatabaseProfile}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Path Data="{StaticResource IconUser}" Stroke="{StaticResource WhiteBrush}"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1.4"
                              Width="13" Height="13" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding OperatorCaption}" FontSize="11"
                                   Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Minimizar"
                            Click="OnMinimizeClick"
                            ToolTip="Minimizar">
                        <Path Data="{StaticResource IconWinMinimize}" Stroke="{StaticResource WhiteBrush}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button Style="{StaticResource TitleBarMaximizeButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Maximizar ou restaurar"
                            Click="OnMaximizeRestoreClick"
                            ToolTip="Maximizar ou restaurar" />
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Fechar"
                            Click="OnCloseClick"
                            ToolTip="Fechar">
                        <Path Data="{StaticResource IconWinClose}" Stroke="{StaticResource WhiteBrush}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ============ Ribbon: abas e grupos de ação ============ -->
        <TabControl Grid.Row="1" SelectedIndex="0"
                    Style="{StaticResource RibbonTabControlStyle}"
                    ItemContainerStyle="{StaticResource RibbonTabItemStyle}">

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconFolder}" Width="14" Height="14" StrokeThickness="1.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Style="{StaticResource IconPathStyle}" />
                        <TextBlock Text="ARQUIVO" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource RibbonDeckStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Novo documento de orçamento (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconNewDocument}" Stroke="{StaticResource TextBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="22" Height="22"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="Novo Doc" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Salvar documento (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconSave}" Stroke="{StaticResource TextBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="22" Height="22"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="Salvar" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Gerar PDF (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconExport}" Stroke="{StaticResource TextBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="22" Height="22"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="Gerar PDF" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Imprimir documento (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconPrint}" Stroke="{StaticResource TextBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="22" Height="22"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="Imprimir" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Novo cliente (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAddPerson}"
                                              Stroke="{StaticResource AccentBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="+ Cliente" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Nova peça ou item (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAddItem}"
                                              Stroke="{StaticResource AccentBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="+ Item" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Novo serviço (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconTool}"
                                              Stroke="{StaticResource AccentBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="+ Serviço" FontSize="11" Margin="7,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Dados recarregados do servidor.">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconRefresh}"
                                              Stroke="{StaticResource TextBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="22" Height="22"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="Recarregar" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding RibbonActionCommand}"
                                        CommandParameter="Ajustes do sistema (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconSettings}"
                                              Stroke="{StaticResource TextBrush}"
                                              Style="{StaticResource IconPathStyle}" Width="22" Height="22"
                                              HorizontalAlignment="Center" />
                                        <TextBlock Text="Ajustes" FontSize="11" HorizontalAlignment="Center"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDocument}" Width="14" Height="14" StrokeThickness="1.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Style="{StaticResource IconPathStyle}" />
                        <TextBlock Text="ORÇAMENTOS" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource RibbonDeckStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Novo orçamento (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconNewDocument}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Novo" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Abrir orçamento (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconFolder}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Abrir" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Duplicar orçamento (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconCopy}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Duplicar" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Aprovar orçamento (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCheckCircle}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Aprovar" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Cancelar orçamento (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCancelCircle}" Stroke="{StaticResource DangerBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Cancelar" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Histórico do orçamento (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconClock}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Histórico" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUsers}" Width="14" Height="14" StrokeThickness="1.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Style="{StaticResource IconPathStyle}" />
                        <TextBlock Text="CADASTROS" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource RibbonDeckStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding OpenClientesCommand}"
                                        IsEnabled="{Binding PodeAcessarClientes}"
                                        AutomationProperties.Name="Clientes"
                                        ToolTip="Cadastro de clientes">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconUsers}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Clientes" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding OpenTecnicosCommand}"
                                        IsEnabled="{Binding PodeAcessarTecnicos}"
                                        AutomationProperties.Name="Técnicos"
                                        ToolTip="Cadastro de técnicos">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconUser}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Técnicos" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding OpenPecasCommand}"
                                         IsEnabled="{Binding PodeAcessarPecas}"
                                         AutomationProperties.AutomationId="OpenPecasRibbon"
                                         AutomationProperties.Name="Peças / Itens"
                                         ToolTip="Cadastro de peças e itens">
                                     <StackPanel>
                                         <Path Data="{StaticResource IconAddItem}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                         <TextBlock Text="Peças / Itens" Style="{StaticResource RibbonButtonLabelStyle}" />
                                     </StackPanel>
                                 </Button>
                                 <!-- Módulo implementado: Serviços / Mão de Obra -->
                                 <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding OpenServicosCommand}"
                                         IsEnabled="{Binding PodeAcessarServicos}"
                                         AutomationProperties.AutomationId="OpenServicosRibbon"
                                         AutomationProperties.Name="Serviços"
                                         ToolTip="Cadastro de serviços e mão de obra">
                                     <StackPanel>
                                         <Path Data="{StaticResource IconTool}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                         <TextBlock Text="Serviços" Style="{StaticResource RibbonButtonLabelStyle}" />
                                     </StackPanel>
                                 </Button>
                                <!-- Módulo implementado: Usuários e Perfis -->
                                <Button Style="{StaticResource RibbonLargeButtonStyle}"
                                        Command="{Binding OpenUsuariosPerfisCommand}" CommandParameter="usuarios"
                                        IsEnabled="{Binding PodeAcessarUsuariosPerfis}"
                                        AutomationProperties.Name="Usuários e Perfis"
                                        ToolTip="Cadastro de usuários, perfis e permissões">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconUsers}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Usuários e Perfis" Width="68" FontSize="10"
                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Empresas e filiais (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Empresas" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Importar dados de cadastro (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconImport}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Importar" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Exportar dados de cadastro (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExport}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Exportar" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconChart}" Width="14" Height="14" StrokeThickness="1.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Style="{StaticResource IconPathStyle}" />
                        <TextBlock Text="RELATÓRIOS" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource RibbonDeckStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Central de relatórios (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconTable}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Central" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Relatório de vendas (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconTrendUp}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Vendas" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Relatório de produção (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconTool}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Produção" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Relatório financeiro (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconPie}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Financeiro" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Exportar relatório em PDF (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconExport}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Exportar PDF" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Exportar planilha (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconImport}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Exportar Excel" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSettings}" Width="14" Height="14" StrokeThickness="1.5"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=TabItem}, Path=Foreground}"
                              Style="{StaticResource IconPathStyle}" />
                        <TextBlock Text="SISTEMA" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Border Style="{StaticResource RibbonDeckStyle}">
                    <StackPanel Orientation="Horizontal" Margin="4,0">
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding OpenUsuariosPerfisCommand}" CommandParameter="usuarios"
                                        IsEnabled="{Binding PodeAcessarUsuariosPerfis}" ToolTip="Cadastro de usuários (aba Usuários)">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconUsers}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Usuários" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding OpenUsuariosPerfisCommand}" CommandParameter="perfis"
                                        IsEnabled="{Binding PodeAcessarUsuariosPerfis}" ToolTip="Cadastro de perfis e permissões (aba Perfis)">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconShield}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Perfis" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Base de dados e conexões (módulo em desenvolvimento).">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconDatabase}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Base de Dados" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Backup da base de dados (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconSave}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Backup" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource RibbonSmallButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Log de auditoria (módulo em desenvolvimento).">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconList}" Stroke="{StaticResource AccentBrush}" Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                        <TextBlock Text="Auditoria" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RibbonLargeButtonStyle}" Command="{Binding RibbonActionCommand}" CommandParameter="Sobre o OrcPro.">
                                    <StackPanel>
                                        <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextBrush}" Style="{StaticResource IconPathStyle}" Width="22" Height="22" />
                                        <TextBlock Text="Sobre" Style="{StaticResource RibbonButtonLabelStyle}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <!-- ============ Corpo: navegação do módulo + conteúdo ============ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Menu lateral: Navegação do Módulo -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource SidebarSectionHeaderStyle}">
                        <Grid>
                            <TextBlock Text="NAVEGAÇÃO DO MÓDULO" Style="{StaticResource SectionLabelStyle}" />
                            <Path Data="{StaticResource IconPanel}" Stroke="{StaticResource TextDisabledBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="14" Height="14"
                                  HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Style="{StaticResource NavigationListStyle}"
                             ItemContainerStyle="{StaticResource NavigationItemStyle}"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="NavIcon" Data="{StaticResource IconDashboard}"
                                          Stroke="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                          Style="{StaticResource IconPathStyle}" StrokeThickness="1.5"
                                          Width="15" Height="15" />
                                    <TextBlock Text="{Binding Title}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Orcamentos">
                                        <Setter TargetName="NavIcon" Property="Data"
                                                Value="{StaticResource IconList}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Cadastros">
                                        <Setter TargetName="NavIcon" Property="Data"
                                                Value="{StaticResource IconFolder}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Relatorios">
                                        <Setter TargetName="NavIcon" Property="Data"
                                                Value="{StaticResource IconChart}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IconKey}" Value="Administracao">
                                        <Setter TargetName="NavIcon" Property="Data"
                                                Value="{StaticResource IconDatabase}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Style="{StaticResource SidebarFooterStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource StatusDotBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DatabaseStatusLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding NetworkLatencyText}" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="13,2,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Área de conteúdo: visão atual do módulo -->
            <Border Grid.Column="1" Background="{StaticResource CanvasBrush}" Padding="8">
                <ContentControl Content="{Binding CurrentView}" />
            </Border>
        </Grid>
        <!-- ============ Rodapé: status do sistema ============ -->
        <Border Grid.Row="3" Background="{StaticResource NavyPanelBrush}">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusBarTextStyle}" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource StatusDotBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ConnectionSummary}" Style="{StaticResource StatusBarTextStyle}" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock Text="{Binding OperatorSummary}" Style="{StaticResource StatusBarTextStyle}" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock Text="{Binding FilialSummary}" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="CAPS" Style="{StaticResource StatusBarTextStyle}" Foreground="#5A6E85" />
                    <TextBlock Text="NUM" Style="{StaticResource StatusBarTextStyle}" Foreground="#5A6E85"
                               Margin="8,0,0,0" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock Text="{Binding ZoomLevel}" Style="{StaticResource StatusBarTextStyle}" />
                    <Border Style="{StaticResource StatusBarSeparatorStyle}" />
                    <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource StatusBarTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
