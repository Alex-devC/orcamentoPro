<UserControl x:Class="OrcPro.App.Views.OrcamentosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:OrcPro.App.Behaviors">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OrcPro.App;component/Resources/CadastroModuleStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabeçalho ===== -->
        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource IconNewDocument}" Stroke="{StaticResource AccentBrush}"
                      Style="{StaticResource IconPathStyle}" Width="18" Height="18" />
                <TextBlock Grid.Column="1" Text="Orçamentos" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="|" Margin="10,0"
                           Foreground="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Propostas, itens, serviços e acompanhamento"
                           Style="{StaticResource PageSubtitleStyle}" />
            </Grid>
        </Border>

        <!-- ===== Conteúdo ===== -->
        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Barra de ferramentas ===== -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="220">
                                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                         Tag="Pesquisar por número, cliente, documento ou status"
                                         AutomationProperties.AutomationId="OrcamentosBusca"
                                         Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextDisabledBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="13" Height="13"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <ComboBox Width="140" Margin="8,0,0,0" Style="{StaticResource FormComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"
                                      Tag="Status"
                                      AutomationProperties.AutomationId="OrcamentosFiltroStatus"
                                      ItemsSource="{Binding FiltrosStatus}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Nome"
                                      SelectedValue="{Binding StatusFiltroId, Mode=TwoWay}" />

                            <ComboBox Width="140" Margin="8,0,0,0" Style="{StaticResource FormComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"
                                      Tag="Cliente"
                                      AutomationProperties.AutomationId="OrcamentosFiltroCliente"
                                      ItemsSource="{Binding FiltrosCliente}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="NomeRazaoSocial"
                                      SelectedValue="{Binding ClienteFiltroId, Mode=TwoWay}" />

                            <DatePicker Width="120" Margin="8,0,0,0"
                                        Tag="De"
                                        AutomationProperties.AutomationId="OrcamentosFiltroDataInicial"
                                        SelectedDate="{Binding DataInicial, Mode=TwoWay}" />
                            <DatePicker Width="120" Margin="8,0,0,0"
                                        Tag="Até"
                                        AutomationProperties.AutomationId="OrcamentosFiltroDataFinal"
                                        SelectedDate="{Binding DataFinal, Mode=TwoWay}" />

                            <Button Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding LimparBuscaCommand}" Content="Limpar busca"
                                    AutomationProperties.AutomationId="OrcamentosLimparBusca" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                    Command="{Binding AtualizarListaCommand}"
                                    AutomationProperties.AutomationId="OrcamentosAtualizar"
                                    ToolTip="Recarregar a listagem">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextMutedBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                    <TextBlock Text="Atualizar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110"
                                    Height="26" FontSize="11" FontWeight="Normal"
                                    Command="{Binding NovoCommand}"
                                    IsEnabled="{Binding PodeCriar}"
                                    AutomationProperties.AutomationId="OrcamentosNovo">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{StaticResource WhiteBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                    <TextBlock Text="Novo orçamento" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Grid ===== -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="OrcamentosGrid"
                              ItemsSource="{Binding Orcamentos}"
                              SelectedItem="{Binding OrcamentoSelecionado, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              AlternationCount="2" BorderThickness="0"
                              Background="{StaticResource SurfaceBrush}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              AutomationProperties.AutomationId="OrcamentosGrid"
                              Sorting="OnGridOrcamentosSorting"
                              MouseDoubleClick="OnOrcamentosGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NÚMERO" Binding="{Binding Numero}" Width="110" SortMemberPath="Numero" />
                            <DataGridTextColumn Header="DATA" Width="90" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="DataEmissao" StringFormat="dd/MM/yyyy" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CLIENTE" Binding="{Binding ClienteNome}" Width="2*" SortMemberPath="ClienteNome" />
                            <DataGridTemplateColumn Header="STATUS" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" Style="{StaticResource StatusBadgeStyle}"
                                                Background="{StaticResource AccentSoftBrush}"
                                                BorderBrush="{StaticResource AccentBrush}">
                                            <TextBlock x:Name="BadgeText" Text="{Binding StatusNome}"
                                                       Style="{StaticResource StatusBadgeTextStyle}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TOTAL" Width="110" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ValorTotal" StringFormat="N2" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="VALIDADE" Width="100" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="DataValidade" StringFormat="dd/MM/yyyy" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="RESPONSÁVEL" Binding="{Binding VendedorNome}" Width="140" CanUserSort="False" />
                            <DataGridTemplateColumn Header="AÇÕES" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.VisualizarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Visualizar"
                                                    AutomationProperties.AutomationId="OrcamentoVisualizarLinha" />
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"
                                                    AutomationProperties.AutomationId="OrcamentoEditarLinha" />
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.AlterarStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Status"
                                                    AutomationProperties.AutomationId="OrcamentoStatusLinha" />
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Excluir"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    AutomationProperties.AutomationId="OrcamentoExcluirLinha" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemRegistros}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconNewDocument}" Stroke="{StaticResource TextDisabledBrush}"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1.2"
                              Width="28" Height="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhum orçamento encontrado com os filtros atuais."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ===== Rodapé ===== -->
                <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="{Binding ResumoPaginacao}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   AutomationProperties.AutomationId="OrcamentosResumo" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PagerButtonStyle}" Command="{Binding PaginaAnteriorCommand}"
                                    AutomationProperties.Name="Pagina anterior de orcamentos">
                                <Path Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextMutedBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="11" Height="11" />
                            </Button>
                            <Button Style="{StaticResource PagerButtonStyle}" Command="{Binding PaginaProximaCommand}"
                                    AutomationProperties.Name="Proxima pagina de orcamentos" Margin="4,0,0,0">
                                <Path Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextMutedBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="11" Height="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <!-- ===== Modal: cadastro/edicao do orcamento ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditorAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="900" MaxHeight="760"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconNewDocument}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="{Binding EditorTitulo}" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>

                            <!-- Resumo de validacao no topo -->
                            <ItemsControl ItemsSource="{Binding ResumoValidacao}"
                                          AutomationProperties.AutomationId="OrcamentoResumoValidacao">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl" BasedOn="{StaticResource ValidationSummaryStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemResumoValidacao}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource ValidationErrorTextStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ===== Emitente (somente leitura, vem de Minha Empresa) ===== -->
                            <Border Style="{StaticResource PanelCardStyle}" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="EMITENTE" Style="{StaticResource SectionLabelStyle}" />
                                    <TextBlock Text="{Binding EmitenteResumo}" FontSize="12"
                                               AutomationProperties.AutomationId="OrcamentoEmitente" />
                                    <TextBlock Style="{StaticResource FormHintStyle}"
                                               Text="Dados da empresa emitente configurados em Minha Empresa." />
                                </StackPanel>
                            </Border>

                            <!-- ===== Cabecalho ===== -->
                            <TextBlock Text="CABECALHO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="NUMERO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormReadOnlyInputStyle}"
                                             Tag="Numero"
                                             AutomationProperties.AutomationId="OrcamentoNumeroInput"
                                             Text="{Binding Numero}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="CLIENTE" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                              TabIndex="1"
                                              Tag="Cliente"
                                              AutomationProperties.AutomationId="OrcamentoClienteCombo"
                                              ItemsSource="{Binding Clientes}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="NomeRazaoSocial"
                                              b:TextFormattingBehavior.CampoInvalido="{Binding ClienteTemErro}"
                                              SelectedValue="{Binding ClienteId, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="VALIDIDADE (DIAS)" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="2"
                                             Tag="Validade"
                                             AutomationProperties.AutomationId="OrcamentoValidadeInput"
                                             b:TextFormattingBehavior.CampoInvalido="{Binding ValidadeTemErro}"
                                             Text="{Binding DiasValidade, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="CONDICOES DE PAGAMENTO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="3"
                                             Tag="Condicoes"
                                             AutomationProperties.AutomationId="OrcamentoCondicoesInput"
                                             b:TextFormattingBehavior.FormatMode="UpperCase"
                                             b:TextFormattingBehavior.EnterNavigation="True"
                                             Text="{Binding CondicoesPagamento, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="PRAZO DE ENTREGA" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="4"
                                             Tag="Prazo"
                                             AutomationProperties.AutomationId="OrcamentoPrazoInput"
                                             b:TextFormattingBehavior.FormatMode="UpperCase"
                                             b:TextFormattingBehavior.EnterNavigation="True"
                                             Text="{Binding PrazoEntrega, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                                    <TextBlock Text="GARANTIA" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="5"
                                             Tag="Garantia"
                                             AutomationProperties.AutomationId="OrcamentoGarantiaInput"
                                             b:TextFormattingBehavior.FormatMode="UpperCase"
                                             b:TextFormattingBehavior.EnterNavigation="True"
                                             Text="{Binding Garantia, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- ===== ITENS DE PECAS ===== -->
                            <Grid Margin="0,16,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ITENS DE PECAS / MATERIAIS"
                                           Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                        Content="+ Adicionar peca"
                                        Click="OnAdicionarItem"
                                        AutomationProperties.AutomationId="OrcamentoAdicionarItem" />
                            </Grid>

                            <DataGrid x:Name="ItensGrid"
                                      ItemsSource="{Binding Itens}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      MaxHeight="180"
                                      BorderThickness="1"
                                      Background="{StaticResource SurfaceBrush}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      AutomationProperties.AutomationId="OrcamentoItensGrid">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="PECA" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                                          AutomationProperties.AutomationId="OrcamentoItemPecaCombo"
                                                          ItemsSource="{Binding DataContext.Pecas, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Codigo"
                                                          SelectionChanged="OnSelecionarPeca"
                                                          SelectedValue="{Binding PecaId, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DESCRICAO" Binding="{Binding Descricao}" Width="2*" />
                                    <DataGridTextColumn Header="UN" Binding="{Binding Unidade}" Width="50" IsReadOnly="True" />
                                    <DataGridTextColumn Header="QTD" Binding="{Binding QuantidadeTexto, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridTextColumn Header="VLR UNIT" Binding="{Binding PrecoTexto, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTextColumn Header="DESC" Binding="{Binding DescontoTexto, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N2}" Width="90" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowActionButtonStyle}"
                                                        Content="Remover"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Tag="{Binding}"
                                                        Click="OnRemoverItem"
                                                        AutomationProperties.AutomationId="OrcamentoItemRemover" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- ===== SERVICOS / MAO DE OBRA ===== -->
                            <Grid Margin="0,16,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SERVICOS / MAO DE OBRA"
                                           Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                                        Content="+ Adicionar servico"
                                        Click="OnAdicionarServico"
                                        AutomationProperties.AutomationId="OrcamentoAdicionarServico" />
                            </Grid>

                            <DataGrid x:Name="ServicosGrid"
                                      ItemsSource="{Binding MaosDeObra}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      IsReadOnly="False" HeadersVisibility="Column" RowHeaderWidth="0"
                                      SelectionMode="Single"
                                      MaxHeight="160"
                                      BorderThickness="1"
                                      Background="{StaticResource SurfaceBrush}"
                                      CellStyle="{StaticResource DataGridCellStyle}"
                                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                                      AutomationProperties.AutomationId="OrcamentoServicosGrid">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="SERVICO" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                                          AutomationProperties.AutomationId="OrcamentoServicoCombo"
                                                          ItemsSource="{Binding DataContext.Servicos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Codigo"
                                                          SelectionChanged="OnSelecionarServico"
                                                          SelectedValue="{Binding ServicoId, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DESCRICAO" Binding="{Binding Descricao}" Width="2*" />
                                    <DataGridTextColumn Header="HORAS" Binding="{Binding HorasTexto, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridTextColumn Header="VLR" Binding="{Binding ValorTexto, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                    <DataGridTemplateColumn Header="TECNICOS" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding TecnicosLinha}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Nome}" FontSize="10"
                                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                    <Button Content="x" FontSize="10" Margin="4,0,0,0"
                                                                            Background="Transparent" BorderThickness="0"
                                                                            Foreground="{StaticResource DangerBrush}"
                                                                            Tag="{Binding}" Click="OnRemoverTecnicoLinha"
                                                                            AutomationProperties.AutomationId="OrcamentoServicoTecnicoRemover" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                                              AutomationProperties.AutomationId="OrcamentoServicoTecnicoCombo"
                                                              ItemsSource="{Binding DataContext.Tecnicos, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              DisplayMemberPath="Nome"
                                                              SelectionChanged="OnSelecionarTecnicoLinha" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="DESC" Binding="{Binding DescontoTexto, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N2}" Width="90" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowActionButtonStyle}"
                                                        Content="Remover"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Tag="{Binding}"
                                                        Click="OnRemoverServico"
                                                        AutomationProperties.AutomationId="OrcamentoServicoRemover" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- ===== TECNICOS ===== -->
                            <Grid Margin="0,16,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TECNICOS DO ORCAMENTO"
                                           Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" Width="220"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          Tag="Tecnico"
                                          AutomationProperties.AutomationId="OrcamentoTecnicoCombo"
                                          ItemsSource="{Binding Tecnicos}"
                                          DisplayMemberPath="Nome"
                                          SelectionChanged="OnSelecionarTecnico" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding TecnicosSelecionados}"
                                          AutomationProperties.AutomationId="OrcamentoTecnicosLista">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}"
                                                Background="{StaticResource SurfaceHighBrush}"
                                                BorderBrush="{StaticResource BorderStrongBrush}"
                                                Margin="0,0,6,6" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nome}" FontSize="11" />
                                                <Button Content="x" Margin="6,0,0,0" FontSize="11"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Tag="{Binding}"
                                                        Click="OnRemoverTecnico"
                                                        AutomationProperties.AutomationId="OrcamentoTecnicoRemover" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ===== OBSERVACOES ===== -->
                            <TextBlock Text="OBSERVACOES" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <TextBox Style="{StaticResource FormMultilineInputStyle}" Height="60"
                                     Tag="Observacoes"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="OrcamentoObservacoesInput"
                                     b:TextFormattingBehavior.FormatMode="UpperCase"
                                     Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- ===== TOTAIS ===== -->
                            <Border Style="{StaticResource PanelCardStyle}" Padding="12" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="SUBTOTAL PECAS" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12"
                                               Text="{Binding SubtotalPecas, StringFormat=N2}"
                                               AutomationProperties.AutomationId="OrcamentoSubtotalPecas" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SUBTOTAL SERVICOS" FontSize="12"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,4,0,0"
                                               Text="{Binding SubtotalMaoDeObra, StringFormat=N2}"
                                               AutomationProperties.AutomationId="OrcamentoSubtotalServicos" />

                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="DESCONTO" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBox Width="90" Margin="8,0,0,0"
                                                 Style="{StaticResource FormInputStyle}"
                                                 Tag="Desconto"
                                                 AutomationProperties.AutomationId="OrcamentoDescontoInput"
                                                 b:TextFormattingBehavior.CampoInvalido="{Binding DescontoTemErro}"
                                                 Text="{Binding DescontoGeralTexto, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="ACRESCIMO" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                                   Margin="16,0,0,0" VerticalAlignment="Center" />
                                        <TextBox Width="90" Margin="8,0,0,0"
                                                 Style="{StaticResource FormInputStyle}"
                                                 Tag="Acrecimo"
                                                 AutomationProperties.AutomationId="OrcamentoAcrecimoInput"
                                                 Text="{Binding AcrescimoTexto, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Height="1"
                                            Background="{StaticResource BorderStrongBrush}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="TOTAL GERAL" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="0,8,0,0"
                                               Text="{Binding TotalGeral, StringFormat=C2}"
                                               AutomationProperties.AutomationId="OrcamentoTotalGeral" />
                                </Grid>
                            </Border>

                            <!-- Erro de operacao -->
                            <Border Margin="0,14,0,0">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource FormErrorBadgeStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorMensagemVisivel}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource DangerBrush}"
                                          Style="{StaticResource FormErrorIconStyle}" Width="14" Height="14" />
                                    <TextBlock Text="{Binding EditorMensagem}" Style="{StaticResource FormErrorMessageStyle}"
                                               TextWrapping="Wrap" Margin="6,0,0,0" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="OrcamentoMensagemErro" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                    Content="Cancelar"
                                    Command="{Binding CancelarEditorCommand}"
                                    AutomationProperties.AutomationId="OrcamentoCancelar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Content="Salvar"
                                    Command="{Binding SalvarCommand}"
                                    AutomationProperties.AutomationId="OrcamentoSalvar" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== Modal: visualizacao (somente leitura) ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisualizacaoAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="820" MaxHeight="700"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocument}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Ficha do orcamento" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{Binding EmitenteResumo}" FontSize="12"
                                       AutomationProperties.AutomationId="OrcamentoVisualizacaoEmitente" />
                            <TextBlock Text="{Binding Numero}" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0"
                                       AutomationProperties.AutomationId="OrcamentoVisualizacaoNumero" />
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="STATUS: " />
                                <Run Text="{Binding StatusNome, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Text="HISTORICO" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <ItemsControl ItemsSource="{Binding Historicos}"
                                          AutomationProperties.AutomationId="OrcamentoHistoricoLista">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <Run Text="{Binding DataRegistro, StringFormat=dd/MM/yyyy HH:mm}" />
                                                <Run Text=" - " />
                                                <Run Text="{Binding NomeUsuario, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Descricao}" FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="110"
                                    Content="Fechar"
                                    Command="{Binding FecharVisualizacaoCommand}"
                                    AutomationProperties.AutomationId="OrcamentoVisualizacaoFechar" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== Modal: alterar status ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="440" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Alterar status" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding StatusMensagem}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="16,12,16,0"
                               AutomationProperties.AutomationId="OrcamentoStatusMensagem" />

                    <StackPanel Margin="16,12,16,0">
                        <TextBlock Text="NOVO STATUS" Style="{StaticResource FormLabelStyle}" />
                        <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                  AutomationProperties.AutomationId="OrcamentoStatusCombo"
                                  ItemsSource="{Binding StatusDisponiveisParaSelecao}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Nome"
                                  SelectedValue="{Binding NovoStatusId, Mode=TwoWay}" />

                        <TextBlock Text="OBSERVACAO" Style="{StaticResource FormLabelStyle}" Margin="0,10,0,0" />
                        <TextBox Style="{StaticResource FormMultilineInputStyle}" Height="55"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 AutomationProperties.AutomationId="OrcamentoStatusObservacaoInput"
                                 b:TextFormattingBehavior.FormatMode="UpperCase"
                                 Text="{Binding StatusObservacao, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Border Style="{StaticResource PanelFooterBarStyle}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                    Content="Cancelar"
                                    Click="OnFecharStatus"
                                    AutomationProperties.AutomationId="OrcamentoStatusCancelar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Content="Aplicar"
                                    Command="{Binding ConfirmarStatusCommand}"
                                    AutomationProperties.AutomationId="OrcamentoStatusConfirmar" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== Modal: confirmacao de exclusao ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfirmacaoAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="400" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCancelCircle}" Stroke="{StaticResource DangerBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Excluir orcamento" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ConfirmacaoMensagem}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextBrush}" Margin="16,14,16,0"
                               AutomationProperties.AutomationId="OrcamentoExcluirMensagem" />

                    <Border Style="{StaticResource PanelFooterBarStyle}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                    Content="Cancelar"
                                    Command="{Binding CancelarExclusaoCommand}"
                                    AutomationProperties.AutomationId="OrcamentoExcluirCancelar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Background="{StaticResource DangerBrush}"
                                    Content="Excluir"
                                    Command="{Binding ConfirmarExclusaoCommand}"
                                    AutomationProperties.AutomationId="OrcamentoExcluirConfirmar" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
