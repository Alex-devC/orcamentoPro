<UserControl x:Class="OrcPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OrcPro.App.Converters">

    <UserControl.Resources>
        <converters:HexToSolidColorBrushConverter x:Key="HexToBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Saudação e identificação do usuário logado -->
        <Border Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Bem-vindo ao OrcPro"
                           FontSize="28" FontWeight="SemiBold"
                           Foreground="#2D2D30" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding UsuarioLogado}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#0078D7" />
                    <TextBlock Text=" • "
                               FontSize="14"
                               Foreground="#6C757D" />
                    <TextBlock Text="{Binding UsuarioCargo}"
                               FontSize="14"
                               Foreground="#6C757D" />
                </StackPanel>
                <TextBlock Text="Gerencie orçamentos, clientes e serviços com eficiência."
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="#6C757D" />
            </StackPanel>
        </Border>

        <!-- Summary Cards por status de orçamento -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,24" MinHeight="100">
            <!-- Aberto -->
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Em Aberto" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding OrcamentosAbertos}" FontSize="24" FontWeight="Bold"
                               Foreground="#3B82F6" />
                </StackPanel>
            </Border>
            <!-- Aguardando Aprovação -->
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Aguardando Aprovação" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding OrcamentosAguardandoAprovacao}" FontSize="24" FontWeight="Bold"
                               Foreground="#F59E0B" />
                </StackPanel>
            </Border>
            <!-- Aprovados -->
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Aprovados" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding OrcamentosAprovados}" FontSize="24" FontWeight="Bold"
                               Foreground="#10B981" />
                </StackPanel>
            </Border>
            <!-- Finalizados -->
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Finalizados" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding OrcamentosFinalizados}" FontSize="24" FontWeight="Bold"
                               Foreground="#6B7280" />
                </StackPanel>
            </Border>
        </UniformGrid>

                <!-- Quick Actions Toolbar -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                CornerRadius="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">
                <Button Content="Novo Orçamento"
                        Command="{Binding NovoOrcamentoCommand}"
                        Style="{StaticResource RibbonButtonStyle}"
                        Foreground="#FFFFFF"
                        Background="#0078D7"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        FontSize="13" />
                <Button Content="Clientes"
                        Command="{Binding ClientesCommand}"
                        Style="{StaticResource RibbonButtonStyle}"
                        Foreground="#2D2D30"
                        Background="#E5E7EB"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        FontSize="13" />
                <Button Content="Relatórios"
                        Command="{Binding RelatoriosCommand}"
                        Style="{StaticResource RibbonButtonStyle}"
                        Foreground="#2D2D30"
                        Background="#E5E7EB"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        FontSize="13" />
            </StackPanel>
        </Border>

                <!-- Orçamentos Recentes - DataGrid -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Orçamentos Recentes"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#2D2D30"
                           Margin="15,12,0,0" />

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding OrcamentosRecentes}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserResizeRows="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          BorderBrush="#E0E0E0"
                          BorderThickness="0"
                          FontSize="13"
                          Margin="15,8,15,15"
                          RowHeaderWidth="0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#F3F3F4" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F9FAFB" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F3F3F4" />
                            <Setter Property="Foreground" Value="#2D2D30" />
                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Número"
                                            Binding="{Binding Numero}"
                                            Width="140" />
                        <DataGridTextColumn Header="Cliente"
                                            Binding="{Binding Cliente}"
                                            Width="*" />
                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding Data, StringFormat=d}"
                                            Width="110" />
                        <DataGridTextColumn Header="Valor Total"
                                            Binding="{Binding ValorTotal, StringFormat=C2}"
                                            Width="120" />
                        <DataGridTemplateColumn Header="Status" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="12"
                                            Padding="12,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
