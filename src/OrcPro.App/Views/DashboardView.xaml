<UserControl x:Class="OrcPro.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{Binding WelcomeMessage}" 
                           FontSize="28" FontWeight="SemiBold" 
                           Foreground="#2D2D30" />
                <TextBlock Text="{Binding SubtitleMessage}" 
                           FontSize="14" Margin="0,5,0,0" 
                           Foreground="#6C757D" />
            </StackPanel>
        </Border>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20" MinHeight="120">
            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Orçamentos" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding OrcamentoCount}" FontSize="24" FontWeight="Bold" Foreground="#2D2D30" />
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Clientes" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding ClienteCount}" FontSize="24" FontWeight="Bold" Foreground="#2D2D30" />
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Técnicos" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding TecnicoCount}" FontSize="24" FontWeight="Bold" Foreground="#2D2D30" />
                </StackPanel>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"
                    CornerRadius="8" Margin="5">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock Text="Peças" FontSize="12" Foreground="#6C757D" />
                    <TextBlock Text="{Binding PecaCount}" FontSize="24" FontWeight="Bold" Foreground="#2D2D30" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Recent Activity Placeholder -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Atividade Recente" 
                           FontSize="16" FontWeight="SemiBold" 
                           Foreground="#2D2D30" Margin="15,15,0,0" />

                <TextBlock Grid.Row="1" Text="Nenhuma atividade registrada." 
                           FontSize="13" Foreground="#6C757D" 
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Margin="15,10,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
