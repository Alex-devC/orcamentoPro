<UserControl x:Class="OrcPro.App.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OrcPro.App.Converters"
             xmlns:b="clr-namespace:OrcPro.App.Behaviors"
             xmlns:local="clr-namespace:OrcPro.App.Views"
             xmlns:uc="clr-namespace:OrcPro.App.Controls">

    <UserControl.Resources>
        <!-- Estilos compartilhados dos modulos de cadastro. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OrcPro.App;component/Resources/CadastroModuleStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:DocumentoFormatConverter x:Key="DocumentoFormat" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabeçalho da página ===== -->
        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource IconUsers}" Stroke="{StaticResource AccentBrush}"
                      Style="{StaticResource IconPathStyle}" Width="18" Height="18" />
                <TextBlock Grid.Column="1" Text="Clientes" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="|" Margin="10,0"
                           Foreground="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Cadastro da carteira de clientes"
                           Style="{StaticResource PageSubtitleStyle}" />
            </Grid>
        </Border>

        <!-- ===== Conteúdo: toolbar + grid + rodapé ===== -->
        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
<!-- ===== Barra de ferramentas (pesquisa, filtros e ações) ===== -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="240">
                                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                         Tag="Pesquisar por código, nome, CPF/CNPJ ou cidade"
                                         AutomationProperties.AutomationId="ClientesBusca"
                                         Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextDisabledBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="13" Height="13"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <ComboBox Width="120" Margin="8,0,0,0" Style="{StaticResource FormComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"
                                      Tag="Situação"
                                      AutomationProperties.AutomationId="ClientesFiltroSituacao"
                                      SelectedIndex="{Binding SituacaoFiltro, Mode=TwoWay}">
                                <ComboBoxItem Content="Todos" />
                                <ComboBoxItem Content="Somente ativos" />
                                <ComboBoxItem Content="Somente inativos" />
                            </ComboBox>

                            <ComboBox Width="110" Margin="8,0,0,0" Style="{StaticResource FormComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"
                                      SelectedValuePath="Tag" Tag="Tipo de pessoa"
                                      AutomationProperties.AutomationId="ClientesFiltroTipo"
                                      SelectedValue="{Binding TipoPessoaFiltro, Mode=TwoWay}">
                                <ComboBoxItem Content="Todos" Tag="todos" />
                                <ComboBoxItem Content="Pessoa Física" Tag="PF" />
                                <ComboBoxItem Content="Pessoa Jurídica" Tag="PJ" />
                            </ComboBox>

                            <Button Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding LimparBuscaCommand}" Content="Limpar busca"
                                    AutomationProperties.AutomationId="ClientesLimparBusca" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                    Command="{Binding AtualizarListaCommand}"
                                    AutomationProperties.AutomationId="ClientesAtualizar"
                                    ToolTip="Recarregar a listagem">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource AccentBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                    <TextBlock Text="Atualizar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110"
                                    Height="26" FontSize="11" FontWeight="Normal"
                                    Command="{Binding NovoCommand}"
                                    AutomationProperties.AutomationId="ClientesNovo">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{StaticResource WhiteBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                    <TextBlock Text="Novo cliente" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
<!-- ===== Grid de clientes ===== -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="ClientesGrid"
                              ItemsSource="{Binding Clientes}"
                              SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              AlternationCount="2" BorderThickness="0"
                              Background="{StaticResource SurfaceBrush}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              AutomationProperties.AutomationId="ClientesGrid"
                              Sorting="OnGridClientesSorting"
                              MouseDoubleClick="OnClientesGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="90" SortMemberPath="Codigo" />
                            <DataGridTextColumn Header="NOME / RAZÃO SOCIAL" Binding="{Binding NomeRazaoSocial}" Width="2*" SortMemberPath="NomeRazaoSocial" />
                            <DataGridTextColumn Header="CPF/CNPJ" Width="130" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CpfCnpj" Converter="{StaticResource DocumentoFormat}" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CIDADE" Binding="{Binding Cidade}" Width="*" SortMemberPath="Cidade" />
                            <DataGridTextColumn Header="UF" Binding="{Binding Uf}" Width="50" SortMemberPath="Uf" />
                            <DataGridTextColumn Header="CELULAR" Binding="{Binding Celular}" Width="120" SortMemberPath="Celular" />
                            <DataGridTextColumn Header="E-MAIL" Binding="{Binding Email}" Width="*" CanUserSort="False" />
                            <DataGridTextColumn Header="ORÇAMENTOS" Binding="{Binding QuantidadeOrcamentos}" Width="90" CanUserSort="False" />
                            <DataGridTemplateColumn Header="SITUAÇÃO" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" Style="{StaticResource StatusBadgeStyle}"
                                                Background="{StaticResource AccentSoftBrush}"
                                                BorderBrush="{StaticResource AccentBrush}">
                                            <TextBlock x:Name="BadgeText" Text="Ativo"
                                                       Style="{StaticResource StatusBadgeTextStyle}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource SurfaceHighBrush}" />
                                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="Inativo" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
<DataGridTemplateColumn Header="AÇÕES" Width="248">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.VisualizarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Visualizar"
                                                    AutomationProperties.AutomationId="ClientesVisualizarLinha"
                                                    ToolTip="Visualizar a ficha do cliente" />
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"
                                                    AutomationProperties.AutomationId="ClientesEditarLinha"
                                                    ToolTip="Editar cliente" />
                                            <Button Command="{Binding DataContext.AlternarSituacaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.AutomationId="ClientesSituacaoLinha"
                                                    ToolTip="Ativar ou inativar cliente">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButtonStyle}">
                                                        <!-- O texto vem do estilo (nunca de Content local),
                                                             assim o trigger consegue alternar Ativar/Inativar. -->
                                                        <Setter Property="Content" Value="Ativar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Content" Value="Inativar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Excluir"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    AutomationProperties.AutomationId="ClientesExcluirLinha"
                                                    ToolTip="Excluir cliente (bloqueado quando há orçamentos vinculados)" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
<!-- Estado vazio -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemRegistros}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconUsers}" Stroke="{StaticResource TextDisabledBrush}"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1.2"
                              Width="28" Height="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhum cliente encontrado com os filtros atuais."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ===== Rodapé do grid: paginação ===== -->
                <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="{Binding ResumoPaginacao}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   AutomationProperties.AutomationId="ClientesResumo" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PagerButtonStyle}" Command="{Binding PaginaAnteriorCommand}"
                                    AutomationProperties.Name="Página anterior de clientes">
                                <Path Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextMutedBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="11" Height="11" />
                            </Button>
                            <Button Style="{StaticResource PagerButtonStyle}" Command="{Binding PaginaProximaCommand}"
                                    AutomationProperties.Name="Próxima página de clientes" Margin="4,0,0,0">
                                <Path Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextMutedBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="11" Height="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
<!-- ===== Modal: cadastro/edição de cliente ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditorAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="620" MaxHeight="660"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAddPerson}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="{Binding EditorTitulo}" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="CÓDIGO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormReadOnlyInputStyle}"
                                             Tag="Gerado automaticamente"
                                             AutomationProperties.AutomationId="ClienteCodigoInput"
                                             Text="{Binding FormCodigo}" />
                                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="TIPO" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"
                                              SelectedValuePath="Tag"
                                              TabIndex="1"
                                              AutomationProperties.AutomationId="ClienteTipoCombo"
                                              SelectedValue="{Binding FormTipoPessoa, Mode=TwoWay}">
                                        <ComboBoxItem Content="Pessoa Jurídica" Tag="PJ" />
                                        <ComboBoxItem Content="Pessoa Física" Tag="PF" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="NOME / RAZÃO SOCIAL" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="2"
                                             AutomationProperties.AutomationId="ClienteNomeInput"
                                             Text="{Binding FormNome, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="NOME FANTASIA" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="3"
                                             AutomationProperties.AutomationId="ClienteNomeFantasiaInput"
                                             Text="{Binding FormNomeFantasia, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="CPF / CNPJ" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="4"
                                             AutomationProperties.AutomationId="ClienteCpfCnpjInput"
                                             Text="{Binding FormCpfCnpj, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FormHintStyle}"
                                               Text="Opcional. Com máscara ou só dígitos; validado ao salvar." />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="RG / INSCRIÇÃO ESTADUAL" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="5"
                                             AutomationProperties.AutomationId="ClienteRgIeInput"
                                             Text="{Binding FormRgIe, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
<!-- Contato -->
                            <TextBlock Text="CONTATO" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="TELEFONE" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="6"
                                             AutomationProperties.AutomationId="ClienteTelefoneInput"
                                             Text="{Binding FormTelefone, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="CELULAR" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="7"
                                             AutomationProperties.AutomationId="ClienteCelularInput"
                                             Text="{Binding FormCelular, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="E-MAIL" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="8"
                                             AutomationProperties.AutomationId="ClienteEmailInput"
                                             Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="E-MAIL FINANCEIRO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="9"
                                             AutomationProperties.AutomationId="ClienteEmailFinanceiroInput"
                                             Text="{Binding FormEmailFinanceiro, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
<!-- Endereço -->
                            <TextBlock Text="ENDEREÇO" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="CEP" Style="{StaticResource FormLabelStyle}" />
                                    <uc:CepComLookupControl
                                                 CepText="{Binding FormCep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CepCommand="{Binding ConsultarCepCommand}"
                                                 CanLookup="{Binding CepPodeConsultarManualmente}"
                                                 TabIndex="10"
                                                 AutomationId="ClienteCepInput"
                                                 LupaAutomationId="ClienteCepLupa" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="ENDEREÇO (LOGRADOURO)" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="11"
                                             AutomationProperties.AutomationId="ClienteLogradouroInput"
                                             Text="{Binding FormLogradouro, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="NÚMERO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="12"
                                             AutomationProperties.AutomationId="ClienteNumeroInput"
                                             Text="{Binding FormNumero, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                    <TextBlock Text="BAIRRO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="13"
                                             AutomationProperties.AutomationId="ClienteBairroInput"
                                             Text="{Binding FormBairro, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                    <TextBlock Text="CIDADE" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             TabIndex="14"
                                             AutomationProperties.AutomationId="ClienteCidadeInput"
                                             Text="{Binding FormCidade, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                                    <TextBlock Text="UF" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}" MaxLength="2"
                                             TabIndex="15"
                                             AutomationProperties.AutomationId="ClienteUfInput"
                                             Text="{Binding FormUf, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="COMPLEMENTO" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource FormInputStyle}"
                                         TabIndex="16"
                                         AutomationProperties.AutomationId="ClienteComplementoInput"
                                         Text="{Binding FormComplemento, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
<!-- Observações e situação -->
                            <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <TextBox Style="{StaticResource FormMultilineInputStyle}"
                                     TabIndex="17"
                                     AutomationProperties.AutomationId="ClienteObservacoesInput"
                                     Text="{Binding FormObservacoes, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Content="Ativo" Style="{StaticResource FormCheckBoxStyle}"
                                      IsChecked="{Binding FormAtivo}" Margin="0,14,0,0"
                                      AutomationProperties.AutomationId="ClienteAtivoCheck" />

                            <!-- Aviso sobre orçamentos vinculados -->
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="2"
                                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                                    Padding="8,6" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextMutedBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="14" Height="14" />
                                    <TextBlock Text="{Binding ResumoOrcamentos}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="6,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Mensagem de erro/aviso do formulário -->
                            <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorMensagemVisivel}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource DangerBrush}"
                                          Style="{StaticResource IconPathStyle}" StrokeThickness="1.4"
                                          Width="14" Height="14" />
                                    <TextBlock Text="{Binding EditorMensagem}" FontSize="11"
                                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="ClienteMensagemErro" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rodapé do modal -->
                    <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                        TabIndex="18"
                                        Content="Cancelar"
                                        Command="{Binding CancelarEditorCommand}"
                                        AutomationProperties.AutomationId="ClienteCancelar" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                        TabIndex="19"
                                        Content="Salvar"
                                        Command="{Binding SalvarCommand}"
                                        AutomationProperties.AutomationId="ClienteSalvar" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
<!-- ===== Modal: visualização da ficha ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisualizacaoAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="560" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocument}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Ficha do cliente" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="Código" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormCodigo}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Tipo" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormTipoPessoa}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Nome / Razão Social" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormNome}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="Nome Fantasia" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormNomeFantasia}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="CPF / CNPJ" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormCpfCnpj}" FontSize="12" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="ClienteVisualizacaoCpfCnpj" />
                                <TextBlock Text="RG / IE" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormRgIe}" FontSize="12" Margin="0,0,0,8" />
                            </StackPanel>
<StackPanel Grid.Column="2">
                                <TextBlock Text="CONTATO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="Telefone" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormTelefone}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Celular" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormCelular}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="E-mail" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormEmail}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="E-mail Financeiro" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormEmailFinanceiro}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="ENDEREÇO" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,6" />
                                <TextBlock Text="{Binding FormCep}" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="{Binding FormLogradouro, Mode=OneWay}" />
                                    <Run Text=", " />
                                    <Run Text="{Binding FormNumero, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run Text="{Binding FormBairro, Mode=OneWay}" />
                                    <Run Text=" - " />
                                    <Run Text="{Binding FormCidade, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding FormUf, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding FormComplemento}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,6" />
                                <TextBlock Text="{Binding FormObservacoes}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="110"
                                    Content="Fechar"
                                    Command="{Binding FecharVisualizacaoCommand}"
                                    AutomationProperties.AutomationId="ClienteVisualizacaoFechar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Content="Editar"
                                    Command="{Binding EditarCommand}"
                                    CommandParameter="{Binding ClienteSelecionado}"
                                    AutomationProperties.AutomationId="ClienteVisualizacaoEditar" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
<!-- ===== Modal: confirmação de exclusão ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfirmacaoAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="400" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCancelCircle}" Stroke="{StaticResource DangerBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Excluir cliente" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ConfirmacaoMensagem}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextBrush}" Margin="16,14,16,0" />

                    <Border Style="{StaticResource PanelFooterBarStyle}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                    Content="Cancelar"
                                    Command="{Binding CancelarExclusaoCommand}"
                                    AutomationProperties.AutomationId="ClienteExcluirCancelar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Background="{StaticResource DangerBrush}"
                                    Content="Excluir"
                                    Command="{Binding ConfirmarExclusaoCommand}"
                                    AutomationProperties.AutomationId="ClienteExcluirConfirmar" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
