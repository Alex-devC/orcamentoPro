<UserControl x:Class="OrcPro.App.Views.PecasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OrcPro.App;component/Resources/CadastroModuleStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Cabeçalho da página ===== -->
        <Border Grid.Row="0" Style="{StaticResource PanelCardStyle}" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource IconAddItem}" Stroke="{StaticResource AccentBrush}"
                      Style="{StaticResource IconPathStyle}" Width="18" Height="18" />
                <TextBlock Grid.Column="1" Text="Peças / Itens" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Text="|" Margin="10,0"
                           Foreground="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Cadastro de peças e materiais"
                           Style="{StaticResource PageSubtitleStyle}" />
            </Grid>
        </Border>

        <!-- ===== Conteúdo: toolbar + grid + rodapé ===== -->
        <Border Grid.Row="1" Style="{StaticResource PanelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Barra de ferramentas (pesquisa, filtros e ações) ===== -->
                <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="230">
                                <TextBox Style="{StaticResource SearchTextBoxStyle}"
                                         Tag="Pesquisar por código, descrição, marca ou código de barras"
                                         AutomationProperties.AutomationId="PecasBusca"
                                         Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextDisabledBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="13" Height="13"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,0,0"
                                      IsHitTestVisible="False" />
                            </Grid>

                            <ComboBox Width="120" Margin="8,0,0,0" Style="{StaticResource FormComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource FormComboBoxItemStyle}"
                                      Tag="Situação"
                                      AutomationProperties.AutomationId="PecasFiltroSituacao"
                                      SelectedIndex="{Binding SituacaoFiltro, Mode=TwoWay}">
                                <ComboBoxItem Content="Todos" />
                                <ComboBoxItem Content="Somente ativos" />
                                <ComboBoxItem Content="Somente inativos" />
                            </ComboBox>

                            <Button Style="{StaticResource GhostButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding LimparBuscaCommand}" Content="Limpar busca"
                                    AutomationProperties.AutomationId="PecasLimparBusca" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,6,0"
                                    Command="{Binding AtualizarListaCommand}"
                                    AutomationProperties.AutomationId="PecasAtualizar"
                                    ToolTip="Recarregar a listagem">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextMutedBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                    <TextBlock Text="Atualizar" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110"
                                    Height="26" FontSize="11" FontWeight="Normal"
                                    Command="{Binding NovoCommand}"
                                    IsEnabled="{Binding PodeCriar}"
                                    AutomationProperties.AutomationId="PecasNovo">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Stroke="{StaticResource WhiteBrush}"
                                          Style="{StaticResource IconPathStyle}" Width="13" Height="13" />
                                    <TextBlock Text="Nova peça" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Grid de peças ===== -->
                <Grid Grid.Row="1">
                    <DataGrid x:Name="PecasGrid"
                              ItemsSource="{Binding Pecas}"
                              SelectedItem="{Binding PecaSelecionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              AlternationCount="2" BorderThickness="0"
                              Background="{StaticResource SurfaceBrush}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              AutomationProperties.AutomationId="PecasGrid"
                              Sorting="OnGridPecasSorting"
                              MouseDoubleClick="OnPecasGridDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CÓDIGO" Binding="{Binding Codigo}" Width="100" SortMemberPath="Codigo" />
                            <DataGridTextColumn Header="DESCRIÇÃO" Binding="{Binding Descricao}" Width="2*" SortMemberPath="Descricao" />
                            <DataGridTextColumn Header="CATEGORIA" Binding="{Binding Categoria}" Width="120" SortMemberPath="Categoria" />
                            <DataGridTextColumn Header="MARCA" Binding="{Binding Marca}" Width="120" SortMemberPath="Marca" />
                            <DataGridTextColumn Header="MODELO" Binding="{Binding Modelo}" Width="120" CanUserSort="False" />
                            <DataGridTextColumn Header="UN" Binding="{Binding UnidadeMedida}" Width="50" CanUserSort="False" />
                            <DataGridTextColumn Header="PREÇO VENDA" Width="100" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="PrecoVenda" StringFormat="N2" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ESTOQUE ATUAL" Width="100" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="EstoqueAtual" StringFormat="N3" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ESTOQUE MÍN." Width="100" CanUserSort="False">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="EstoqueMinimo" StringFormat="N3" />
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="SITUAÇÃO" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Badge" Style="{StaticResource StatusBadgeStyle}"
                                                Background="{StaticResource AccentSoftBrush}"
                                                BorderBrush="{StaticResource AccentBrush}">
                                            <TextBlock x:Name="BadgeText" Text="Ativo"
                                                       Style="{StaticResource StatusBadgeTextStyle}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                <Setter TargetName="Badge" Property="Background" Value="{StaticResource SurfaceHighBrush}" />
                                                <Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                <Setter TargetName="BadgeText" Property="Text" Value="Inativo" />
                                                <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="AÇÕES" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.VisualizarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Visualizar"
                                                    AutomationProperties.AutomationId="PecasVisualizarLinha"
                                                    ToolTip="Visualizar a ficha da peça" />
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.EditarCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"
                                                    AutomationProperties.AutomationId="PecasEditarLinha"
                                                    ToolTip="Editar peça" />
                                            <Button Command="{Binding DataContext.AlternarSituacaoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.AutomationId="PecasSituacaoLinha"
                                                    ToolTip="Ativar ou inativar peça">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButtonStyle}">
                                                        <Setter Property="Content" Value="Ativar" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Content" Value="Inativar" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Style="{StaticResource RowActionButtonStyle}"
                                                    Command="{Binding DataContext.ExcluirCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Excluir"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    AutomationProperties.AutomationId="PecasExcluirLinha"
                                                    ToolTip="Excluir peça" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <!-- Estado vazio -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemRegistros}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Path Data="{StaticResource IconAddItem}" Stroke="{StaticResource TextDisabledBrush}"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1.2"
                              Width="28" Height="28" HorizontalAlignment="Center" />
                        <TextBlock Text="Nenhuma peça encontrada com os filtros atuais."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ===== Rodapé do grid: paginação ===== -->
                <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="{Binding ResumoPaginacao}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   AutomationProperties.AutomationId="PecasResumo" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PagerButtonStyle}" Command="{Binding PaginaAnteriorCommand}"
                                    AutomationProperties.Name="Página anterior de peças">
                                <Path Data="{StaticResource IconChevronLeft}" Stroke="{StaticResource TextMutedBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="11" Height="11" />
                            </Button>
                            <Button Style="{StaticResource PagerButtonStyle}" Command="{Binding PaginaProximaCommand}"
                                    AutomationProperties.Name="Próxima página de peças" Margin="4,0,0,0">
                                <Path Data="{StaticResource IconChevronRight}" Stroke="{StaticResource TextMutedBrush}"
                                      Style="{StaticResource IconPathStyle}" Width="11" Height="11" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Modal: cadastro/edição de peça ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditorAberto}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="640" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAddItem}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="{Binding EditorTitulo}" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CÓDIGO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaCodigoInput"
                                             Text="{Binding FormCodigo, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource FormHintStyle}"
                                               Text="Código único de referência da peça." />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="UNIDADE" Style="{StaticResource FormLabelStyle}" />
                                    <ComboBox Style="{StaticResource FormComboBoxStyle}"
                                              AutomationProperties.AutomationId="PecaUnidadeInput"
                                              SelectedItem="{Binding FormUnidadeMedida, Mode=TwoWay}"
                                              Text="{Binding FormUnidadeMedida, Mode=TwoWay}">
                                        <ComboBoxItem Content="UN" />
                                        <ComboBoxItem Content="PC" />
                                        <ComboBoxItem Content="CX" />
                                        <ComboBoxItem Content="MTS" />
                                        <ComboBoxItem Content="LT" />
                                        <ComboBoxItem Content="HR" />
                                        <ComboBoxItem Content="KM" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="DESCRIÇÃO" Style="{StaticResource FormLabelStyle}" />
                                <TextBox Style="{StaticResource FormInputStyle}"
                                         AutomationProperties.AutomationId="PecaDescricaoInput"
                                         Text="{Binding FormDescricao, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <TextBlock Text="CLASSIFICAÇÃO" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="CATEGORIA" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaCategoriaInput"
                                             Text="{Binding FormCategoria, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="CÓDIGO DE BARRAS" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaCodigoBarrasInput"
                                             Text="{Binding FormCodigoBarras, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="MARCA" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaMarcaInput"
                                             Text="{Binding FormMarca, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="MODELO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaModeloInput"
                                             Text="{Binding FormModelo, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="PREÇOS" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PREÇO DE CUSTO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaPrecoCustoInput"
                                             Text="{Binding FormPrecoCusto, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="PREÇO DE VENDA" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaPrecoVendaInput"
                                             Text="{Binding FormPrecoVenda, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ESTOQUE" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ESTOQUE ATUAL" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaEstoqueAtualInput"
                                             Text="{Binding FormEstoqueAtual, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ESTOQUE MÍNIMO" Style="{StaticResource FormLabelStyle}" />
                                    <TextBox Style="{StaticResource FormInputStyle}"
                                             AutomationProperties.AutomationId="PecaEstoqueMinimoInput"
                                             Text="{Binding FormEstoqueMinimo, StringFormat=N3, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource SectionLabelStyle}" Margin="0,16,0,6" />
                            <TextBox Style="{StaticResource FormMultilineInputStyle}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.AutomationId="PecaObservacoesInput"
                                     Text="{Binding FormObservacoes, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Content="Ativo" Style="{StaticResource FormCheckBoxStyle}"
                                      IsChecked="{Binding FormAtivo}" Margin="0,14,0,0"
                                      AutomationProperties.AutomationId="PecaAtivoCheck" />

                            <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,12,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorMensagemVisivel}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource DangerBrush}"
                                          Style="{StaticResource IconPathStyle}" StrokeThickness="1.4"
                                          Width="14" Height="14" />
                                    <TextBlock Text="{Binding EditorMensagem}" FontSize="11"
                                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                               Margin="6,0,0,0" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="PecaMensagemErro" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                    Content="Cancelar"
                                    Command="{Binding CancelarEditorCommand}"
                                    AutomationProperties.AutomationId="PecaCancelar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Content="Salvar"
                                    Command="{Binding SalvarCommand}"
                                    AutomationProperties.AutomationId="PecaSalvar" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== Modal: visualização da ficha (somente leitura) ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VisualizacaoAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="560" MaxHeight="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDocument}" Stroke="{StaticResource AccentBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Ficha da peça" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="Código" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormCodigo}" FontSize="12" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="PecaVisualizacaoCodigo" />
                                <TextBlock Text="Descrição" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormDescricao}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           AutomationProperties.AutomationId="PecaVisualizacaoDescricao" />
                                <TextBlock Text="Unidade" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormUnidadeMedida}" FontSize="12" Margin="0,0,0,8" />
                                <TextBlock Text="Situação" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock FontSize="12" Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Ativo" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormAtivo}" Value="False">
                                                    <Setter Property="Text" Value="Inativo" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CLASSIFICAÇÃO" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,6" />
                                <TextBlock Text="Categoria" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormCategoria}" FontSize="12" Margin="0,0,8"
                                           AutomationProperties.AutomationId="PecaVisualizacaoCategoria" />
                                <TextBlock Text="Marca" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormMarca}" FontSize="12" Margin="0,0,8" />
                                <TextBlock Text="Modelo" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormModelo}" FontSize="12" Margin="0,0,8" />
                                <TextBlock Text="Código de Barras" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormCodigoBarras}" FontSize="12" Margin="0,0,8" />

                                <TextBlock Text="PREÇOS" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,6" />
                                <TextBlock Text="Preço de Custo" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormPrecoCusto, StringFormat=N2}" FontSize="12" Margin="0,0,8" />
                                <TextBlock Text="Preço de Venda" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormPrecoVenda, StringFormat=N2}" FontSize="12" Margin="0,0,8" />

                                <TextBlock Text="ESTOQUE" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,6" />
                                <TextBlock Text="Estoque Atual" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormEstoqueAtual, StringFormat=N3}" FontSize="12" Margin="0,0,8" />
                                <TextBlock Text="Estoque Mínimo" Style="{StaticResource FormLabelStyle}" />
                                <TextBlock Text="{Binding FormEstoqueMinimo, StringFormat=N3}" FontSize="12" Margin="0,0,8" />

                                <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,6" />
                                <TextBlock Text="{Binding FormObservacoes}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" Style="{StaticResource PanelFooterBarStyle}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="110"
                                    Content="Fechar"
                                    Command="{Binding FecharVisualizacaoCommand}"
                                    AutomationProperties.AutomationId="PecaVisualizacaoFechar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Content="Editar"
                                    Command="{Binding EditarCommand}"
                                    CommandParameter="{Binding PecaSelecionada}"
                                    AutomationProperties.AutomationId="PecaVisualizacaoEditar" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- ===== Modal: confirmação de exclusão ===== -->
        <Border Grid.Row="0" Grid.RowSpan="2">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource ModalOverlayStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ConfirmacaoAberta}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Border Style="{StaticResource PanelCardStyle}" Width="400" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <Border Style="{StaticResource PanelHeaderBarStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCancelCircle}" Stroke="{StaticResource DangerBrush}"
                                  Style="{StaticResource IconPathStyle}" Width="15" Height="15" />
                            <TextBlock Text="Excluir peça" Style="{StaticResource PanelHeaderStyle}"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ConfirmacaoMensagem}" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextBrush}" Margin="16,14,16,0"
                               AutomationProperties.AutomationId="PecaExcluirMensagem" />

                    <Border Style="{StaticResource PanelFooterBarStyle}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" MinWidth="90"
                                    Content="Cancelar"
                                    Command="{Binding CancelarExclusaoCommand}"
                                    AutomationProperties.AutomationId="PecaExcluirCancelar" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" Margin="8,0,0,0"
                                    Background="{StaticResource DangerBrush}"
                                    Content="Excluir"
                                    Command="{Binding ConfirmarExclusaoCommand}"
                                    AutomationProperties.AutomationId="PecaExcluirConfirmar" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
