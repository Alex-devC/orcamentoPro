<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrcPro.Application\OrcPro.Application.csproj" />
    <ProjectReference Include="..\OrcPro.Infrastructure\OrcPro.Infrastructure.csproj" />
    <ProjectReference Include="..\OrcPro.Domain\OrcPro.Domain.csproj" />
  </ItemGroup>

          <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Icone do executavel (Explorer, barra de tarefas, Alt+Tab). Gerado a partir da marca "A" de ux/logo.png/screen.png. -->
    <ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
    <!-- Saída da build apontada para a pasta publish/ na raiz do projeto (mesmo destino do publish). -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\publish\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
    <GenerateManifestsForSelfContainedApplication>false</GenerateManifestsForSelfContainedApplication>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesma arte como recurso WPF, para Icon="Assets/favicon.ico" nas janelas. -->
    <Resource Include="Assets\favicon.ico" />
  </ItemGroup>

</Project>
