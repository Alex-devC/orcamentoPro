<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrcPro.Application\OrcPro.Application.csproj" />
    <ProjectReference Include="..\OrcPro.Infrastructure\OrcPro.Infrastructure.csproj" />
    <ProjectReference Include="..\OrcPro.Domain\OrcPro.Domain.csproj" />
  </ItemGroup>

          <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Saída da build apontada para a pasta publish/ na raiz do projeto (mesmo destino do publish). -->
    <OutputPath>$(MSBuildThisFileDirectory)..\..\publish\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\</PublishDir>
    <GenerateManifestsForSelfContainedApplication>false</GenerateManifestsForSelfContainedApplication>
  </PropertyGroup>

</Project>
