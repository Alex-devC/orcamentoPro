<Window x:Class="OrcPro.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/favicon.ico"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:OrcPro.App.Controls"
        Title="OrcPro — Acesso"
        Width="460" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="{StaticResource DefaultFontFamily}"
        FontSize="12"
        Background="{StaticResource CanvasBrush}"
        Loaded="OnLoaded">

    <!-- Mesmo chrome da MainWindow: legenda de 32px com arrasto e botões clicáveis. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Input de texto: baseado no SearchTextBoxStyle do tema (borda 1px, focus cyan,
             watermark via Tag), apenas com padding sem ícone. -->
        <Style x:Key="LoginInputStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0,6,0" />
        </Style>

        <!-- Input de senha com o mesmo desenho do input de texto do tema. -->
        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderInputBrush}" BorderThickness="1" CornerRadius="2">
                            <Grid>
                                <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource TextDisabledBrush}" FontSize="11"
                                           Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                           Visibility="Visible" />
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox com cantos retos e acento cyan, alinhado à identidade do tema. -->
        <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2.5,6.8 L5.8,10 L11.2,4.2"
                                      Stroke="{StaticResource WhiteBrush}" StrokeThickness="1.8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão primário do tema com rótulo centralizado e estado "Entrando...". -->
        <Style x:Key="LoginSubmitStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Content" Value="Entrar" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Content" Value="Entrando..." />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Barra superior / Title bar (padrão OrcPro) ============ -->
        <Border Grid.Row="0" Background="{StaticResource NavyBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="3" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="O" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource WhiteBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="OrcPro — Acesso" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource WhiteBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                    <Border Width="1" Height="13" Background="{StaticResource NavyDividerBrush}"
                            Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="ALEX T.I. Tecnologia e Assistência" FontSize="11"
                               Foreground="{StaticResource NavyMutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Minimizar"
                            Click="OnMinimizeClick"
                            ToolTip="Minimizar">
                        <Path Data="{StaticResource IconWinMinimize}" Stroke="{StaticResource WhiteBrush}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Fechar"
                            Click="OnCloseClick"
                            ToolTip="Fechar">
                        <Path Data="{StaticResource IconWinClose}" Stroke="{StaticResource WhiteBrush}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              Style="{StaticResource IconPathStyle}" StrokeThickness="1" Width="10" Height="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Corpo: cartão de login ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <Border Style="{StaticResource PanelCardStyle}" Padding="24" MaxWidth="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Marca -->
                    <Border Width="48" Height="48" CornerRadius="4"
                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="O" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource WhiteBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="OrcPro" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="Sistema de Orçamentos Técnicos" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,16,0,0" />

                    <!-- Usuário -->
                    <TextBlock Text="USUÁRIO" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,4" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource LoginInputStyle}"
                             Tag="Digite seu usuário"
                             AutomationProperties.AutomationId="UsernameInput"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Senha -->
                    <TextBlock Text="SENHA" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource LoginPasswordStyle}"
                                 Tag="Digite sua senha"
                                 AutomationProperties.AutomationId="PasswordInput"
                                 PasswordChanged="OnPasswordChanged"
                                 controls:PasswordBoxAssistant.BindPassword="{Binding Senha, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Lembrar usuário -->
                    <CheckBox Content="Lembrar usuário" Style="{StaticResource LoginCheckBoxStyle}"
                              IsChecked="{Binding LembrarUsuario}" Margin="0,12,0,0"
                              AutomationProperties.AutomationId="RememberUser" />

                    <!-- Mensagem de erro (credenciais inválidas, campos vazios, falhas) -->
                    <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="8,6" Margin="0,12,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TemErro}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource DangerBrush}"
                                  Style="{StaticResource IconPathStyle}" StrokeThickness="1.4"
                                  Width="14" Height="14" />
                            <!-- AutomationId no TextBlock: Border não expõe peer de automação. -->
                            <TextBlock Text="{Binding MensagemErro}" FontSize="11"
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="ErrorMessage" />
                        </StackPanel>
                    </Border>

                    <!-- Entrar -->
                    <Button x:Name="LoginButton" Style="{StaticResource LoginSubmitStyle}"
                            Command="{Binding EntrarCommand}" IsDefault="True"
                            Margin="0,16,0,0" Height="34" MinWidth="0"
                            AutomationProperties.AutomationId="LoginButton" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ============ Rodapé ============ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="0,8">
            <TextBlock Text="v2.6.4 — Acesso restrito a usuários autorizados"
                       FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" />
        </Border>
    </Grid>
</Window>
