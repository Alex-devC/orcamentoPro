<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="clr-namespace:OrcPro.App.Behaviors"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <!-- ================================================================
         OrcPro - Enterprise Desktop Theme
         Reference: ux/alex_or_amentos_desktop_enterprise_system/DESIGN.md
           Deep Enterprise Navy ..... #0A192F / #0F2A4A
           Vibrant Precision Cyan ... #0090D9 / #00A3FF
           Canvas / Surfaces ........ #F3F5F8 / #FFFFFF
           Structural borders ....... #D9DFE7 / #B8C5D3
         ================================================================ -->

    <!-- ============================= Colors ============================= -->
    <Color x:Key="NavyColor">#0A192F</Color>
    <Color x:Key="NavyPanelColor">#0F2A4A</Color>
    <Color x:Key="AccentColor">#0090D9</Color>
    <Color x:Key="AccentHoverColor">#00A3FF</Color>
    <Color x:Key="CanvasColor">#F3F5F8</Color>
    <Color x:Key="WhiteColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#1E293B</Color>
    <Color x:Key="TextMutedColor">#475569</Color>
    <Color x:Key="BorderSoftColor">#D9DFE7</Color>

    <!-- Legacy aliases (kept for compatibility with existing bindings) -->
    <Color x:Key="PrimaryColor">#0A192F</Color>
    <Color x:Key="SecondaryColor">#0F2A4A</Color>
    <Color x:Key="BackgroundColor">#F3F5F8</Color>
    <Color x:Key="TextSecondaryColor">#475569</Color>
    <Color x:Key="BorderColor">#D9DFE7</Color>

    <!-- ============================= Brushes ============================ -->
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="NavyPanelBrush" Color="{StaticResource NavyPanelColor}" />
    <SolidColorBrush x:Key="NavyDividerBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="NavyMutedTextBrush" Color="#7A92B7" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0F2FE" />

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#E6E8EB" />
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#E0E3E6" />
    <SolidColorBrush x:Key="GridHeaderBrush" Color="#ECEFF3" />
    <SolidColorBrush x:Key="RowAltBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F2F4F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="HoverControlBrush" Color="#E2E8F0" />

    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B8C5D3" />
    <SolidColorBrush x:Key="BorderInputBrush" Color="#CBD5E1" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="#BA1A1A" />
    <SolidColorBrush x:Key="StatusDotBrush" Color="#49B3FE" />

    <!-- Legacy aliases -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- KPI icon containers -->
    <SolidColorBrush x:Key="KpiNeutralBrush" Color="#ECEFF3" />
    <SolidColorBrush x:Key="KpiPendingBrush" Color="#CCE5FF" />
    <SolidColorBrush x:Key="KpiApprovedBrush" Color="#49B3FE" />
    <SolidColorBrush x:Key="KpiExecBrush" Color="#D6E3FF" />
    <SolidColorBrush x:Key="KpiDoneBrush" Color="#D4E3FF" />
    <SolidColorBrush x:Key="KpiCancelBrush" Color="#FFDAD6" />
    <SolidColorBrush x:Key="KpiPendingTextBrush" Color="#004B73" />
    <SolidColorBrush x:Key="KpiApprovedTextBrush" Color="#004368" />
    <SolidColorBrush x:Key="KpiExecTextBrush" Color="#0D1C32" />
    <SolidColorBrush x:Key="KpiDoneTextBrush" Color="#304869" />

    <!-- ============================== Fonts ============================= -->
    <FontFamily x:Key="DefaultFontFamily">Inter, Aptos, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Segoe UI, Tahoma</FontFamily>

