<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OrcPro.App.ViewModels"
                    xmlns:views="clr-namespace:OrcPro.App.Views">

    <!-- Dashboard -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <views:DashboardView />
    </DataTemplate>

    <!-- Cadastro de Clientes -->
    <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
        <views:ClientesView />
    </DataTemplate>

    <!-- Cadastro de Técnicos -->
    <DataTemplate DataType="{x:Type vm:TecnicosViewModel}">
        <views:TecnicosView />
    </DataTemplate>

    <!-- Cadastro de Peças / Itens -->
    <DataTemplate DataType="{x:Type vm:PecasViewModel}">
        <views:PecasView />
    </DataTemplate>

    <!-- Cadastro de Serviços / Mão de Obra -->
    <DataTemplate DataType="{x:Type vm:ServicosViewModel}">
        <views:ServicosView />
    </DataTemplate>

    <!-- Configurações: Minha Empresa / Emitente -->
    <DataTemplate DataType="{x:Type vm:MinhaEmpresaViewModel}">
        <views:MinhaEmpresaView />
    </DataTemplate>

    <!-- Cadastro de Usuários e Perfis (abas Usuários / Perfis) -->
    <DataTemplate DataType="{x:Type vm:UsuariosPerfisViewModel}">
        <views:UsuariosPerfisView />
    </DataTemplate>

    <!-- Placeholder para módulos ainda não implementados -->
    <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
        <Border Background="{StaticResource CanvasBrush}" Padding="16">
            <Border Style="{StaticResource PanelCardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,32">
                    <Path Data="{StaticResource IconSettings}" Stroke="{StaticResource TextDisabledBrush}"
                          Style="{StaticResource IconPathStyle}" StrokeThickness="1.2"
                          Width="36" Height="36" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="420" Margin="0,6,0,0"
                               Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </DataTemplate>
</ResourceDictionary>
